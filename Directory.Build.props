<Project>

  <!--
    Solution-wide build settings.

    Strictness is deliberate: the public surface of this library is small, so every
    type and member is expected to carry XML documentation and to be nullable-annotated.
    Warnings are errors so that a documentation or nullability gap fails the build
    rather than accumulating.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Package and repository identity, shared by every packable project.
    RepositoryUrl also drives SourceLink, which is in-box from the .NET 8 SDK onwards:
    PublishRepositoryUrl and EmbedUntrackedSources let a consumer step into this code
    from a debugger without a separate SourceLink package reference.
  -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>CarlosK</Authors>
    <Copyright>Copyright (c) 2026 CarlosK</Copyright>
    <PackageTags>logging;ilogger;throttling;progress;eta;diagnostics</PackageTags>
    <PackageProjectUrl>https://github.com/CarlosSolrac/throttled-for-loop-logging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CarlosSolrac/throttled-for-loop-logging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Binary metadata required by the SignPath Foundation conditions for open source projects:
    the product name attribute must carry the project's name, and the product version attributes
    must be the same value in every build of a given version, so that the SignPath artifact
    configuration can enforce them. Everything below is derived from the single Version property.

    IncludeSourceRevisionInInformationalVersion is off deliberately: the SDK otherwise appends
    "+<commit sha>" to AssemblyInformationalVersion, which is the attribute read as the product
    version, and that suffix differs from build to build. SourceLink still embeds the commit, so
    nothing is lost for debugging. See docs/code-signing.md.
  -->
  <PropertyGroup>
    <Product>ThrottledForLoopLogging</Product>
    <AssemblyVersion>$(Version.Split('-')[0])</AssemblyVersion>
    <FileVersion>$(Version.Split('-')[0])</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
