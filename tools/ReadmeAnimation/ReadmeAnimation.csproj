<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regenerates docs/images/throttled-for-loop.svg, the animation at the top of README.md.

    It runs a scripted loop through the real library on a fake clock and draws what the loop
    submitted and what reached ILogger, so the picture cannot drift from the log format.
    Run it from the repository root: dotnet run, project tools/ReadmeAnimation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ThrottledLogging.ReadmeAnimation</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ThrottledLogging/ThrottledLogging.csproj" />
  </ItemGroup>

</Project>
